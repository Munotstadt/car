{
  "name": "car",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Nur ueber car.munot.app (hinter Cloudflare Access) erreichbar, nicht ueber workers.dev.
  "workers_dev": false,
  "preview_urls": false,

  // Statische Seiten (public/) werden vom Worker ausgeliefert (Zugriffsschutz: Cloudflare Access).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Setzt voraus, dass munot.app als Zone im selben Cloudflare-Account liegt.
  "routes": [
    { "pattern": "car.munot.app", "custom_domain": true }
  ],

  // D1-Datenbank "car" (Tabellen skoda_collector_tbl, skoda_trips_tbl, skoda_activites_tbl)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "car",
      "database_id": "8dcdf6f9-0ccb-4608-bb7d-90580afdc02f"
    }
  ]
}
